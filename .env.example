# Shared / local development
NODE_ENV=development

# API
API_PORT=4100
API_PUBLIC_URL=http://localhost:4100
DASHBOARD_URL=http://localhost:3100
COOKIE_DOMAIN=
SESSION_COOKIE_NAME=unpirator_session
SESSION_TTL_HOURS=24
RESEND_API_KEY=
EMAIL_FROM=The Unpirator <noreply@example.com>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4100/v1/auth/google/callback

# PostgreSQL: Neon initially; any standard PostgreSQL DATABASE_URL works.
DATABASE_URL=postgresql://unpirator:unpirator@localhost:55432/unpirator

# Redis: use either standard Redis URL OR Upstash REST credentials.
REDIS_URL=redis://localhost:56379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Encryption key for provider credentials (32-byte key, base64 encoded)
APP_ENCRYPTION_KEY_BASE64=

# Playback signing key ring. JSON array encoded as base64.
# Generate with: pnpm keys:generate
SIGNING_KEYS_B64=
ACTIVE_SIGNING_KID=

# Gateway internal control/resolution
GATEWAY_INTERNAL_SECRET=change-me-with-a-long-random-secret
GATEWAY_PUBLIC_URL=http://localhost:8787
GATEWAY_CONTROL_URL=http://localhost:8787
GATEWAY_CONTROL_SECRET=change-me-with-another-long-random-secret

# Provider feature switch. Intentionally disabled by default.
YOUTUBE_CUSTOM_GLOBAL=false

# Optional platform bootstrap
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=

