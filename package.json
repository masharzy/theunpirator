{
  "name": "the-unpirator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @unpirator/dashboard --filter @unpirator/api dev",
    "dev:dashboard": "pnpm --filter @unpirator/dashboard dev",
    "dev:api": "pnpm --filter @unpirator/api dev",
    "dev:gateway": "pnpm --filter @unpirator/media-gateway dev",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "test:unit": "pnpm -r --if-present test:unit",
    "test:e2e": "pnpm --filter @unpirator/dashboard test:e2e",
    "lint": "eslint apps packages providers workers integrations/nextjs scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @unpirator/db db:generate",
    "db:migrate": "pnpm --filter @unpirator/db db:migrate",
    "db:studio": "pnpm --filter @unpirator/db db:studio",
    "keys:generate": "node scripts/generate-signing-key.js",
    "check:syntax": "node scripts/check-syntax.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "vitest": "^3.2.4"
  }
}
